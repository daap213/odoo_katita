<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Acción de reporte: imprime el código del ítem como QR (nativo) -->
    <record id="action_report_katita_qr" model="ir.actions.report">
        <field name="name">Código QR</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">katita_custom.report_katita_qr_document</field>
        <field name="report_file">katita_custom.report_katita_qr_document</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_katita_qr_document">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="o">
                <div class="page" style="text-align:center; page-break-inside:avoid; padding:8mm;">
                    <h3 t-out="o.name"/>
                    <div t-if="o.katita_codigo">
                        <span t-field="o.katita_codigo"
                              t-options="{'widget': 'barcode', 'symbology': 'QR', 'width': 200, 'height': 200}"/>
                        <div style="margin-top:4mm; font-weight:bold;" t-out="o.katita_codigo"/>
                    </div>
                    <div t-else="" class="text-muted">Sin código definido para este ítem.</div>
                </div>
            </t>
        </t>
    </template>
</odoo>
