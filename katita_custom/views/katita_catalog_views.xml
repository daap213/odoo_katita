                    <field name="siglas" placeholder="Ej. NK"/>
                    <field name="observacion" placeholder="Observaciones (opcional)"/>
                </group>
            </form>
        </field>
    </record>
    <record id="action_katita_marca" model="ir.actions.act_window">
        <field name="name">Marcas</field>
