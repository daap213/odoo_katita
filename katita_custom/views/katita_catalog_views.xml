<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===================== LÍNEA ===================== -->
    <record id="view_katita_linea_list" model="ir.ui.view">
        <field name="name">katita.linea.list</field>
        <field name="model">katita.linea</field>
        <field name="arch" type="xml">
            <list string="Líneas" editable="bottom">
                <field name="name"/>
                <field name="siglas"/>
                <field name="pos_category_id" readonly="1"/>
                <field name="observacion"/>
            </list>
        </field>
    </record>
    <record id="view_katita_linea_form" model="ir.ui.view">
        <field name="name">katita.linea.form</field>
        <field name="model">katita.linea</field>
        <field name="arch" type="xml">
            <form string="Línea">
                <group>
                    <field name="name" placeholder="Ej. Zapato"/>
                    <field name="siglas" placeholder="Ej. ZAP"/>
                    <field name="observacion" placeholder="Observaciones (opcional)"/>
                </group>
            </form>
        </field>
    </record>
    <record id="action_katita_linea" model="ir.actions.act_window">
        <field name="name">Líneas</field>
        <field name="res_model">katita.linea</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ===================== MARCA ====================== -->
