    <!-- ===================== MENÚS (Inventario → Configuración) ======================= -->
    <menuitem id="menu_katita_config" name="Katita" parent="stock.menu_stock_config_settings"
              sequence="50" groups="stock.group_stock_manager"/>
    <menuitem id="menu_katita_linea" name="Líneas" parent="menu_katita_config" action="action_katita_linea" sequence="10"/>
    <menuitem id="menu_katita_marca" name="Marcas" parent="menu_katita_config" action="action_katita_marca" sequence="20"/>
    <menuitem id="menu_katita_modelo" name="Modelos" parent="menu_katita_config" action="action_katita_modelo" sequence="30"/>
    <menuitem id="menu_katita_color" name="Colores" parent="menu_katita_config" action="action_katita_color" sequence="40"/>
    <menuitem id="menu_katita_genero" name="Géneros" parent="menu_katita_config" action="action_katita_genero" sequence="50"/>
</odoo>
